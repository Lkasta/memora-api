# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real secrets.

# Required
DATABASE_URL=postgresql://user:password@localhost:5432/memora
SECRET_KEY=change-me
FLASK_ENV=development

# Image storage. Needed only so images can be deleted from the bucket when a
# memory is removed or an image is taken out of its text - without it the app
# still tracks them in the database. UPLOADTHING_TOKEN is the same value the
# frontend uses; alternatively set UPLOADTHING_API_KEY to a raw "sk_..." key.
UPLOADTHING_TOKEN=
# UPLOADTHING_API_KEY=
# UPLOADTHING_API_URL=https://api.uploadthing.com

# Optional (defaults shown)
# JWT_SECRET_KEY=chave_dev_super_secreta
# JWT_ACCESS_TOKEN_EXPIRES_HOURS=8
# CORS_ORIGINS=https://memora.lkasta.com,http://localhost:3000
# PORT=5000
